/* ===== 設計系統 tokens ===== */
page {
  --canvas: #f4f6fb;
  --card: #ffffff;
  --ink: #0f172a;
  --muted: #64748b;
  --faint: #94a3b8;
  --line: #e8ecf4;
  --primary: #4f46e5;
  --primary-2: #7c3aed;
  --success: #10b981;
  --warn: #f59e0b;
  --danger: #ef4444;
  --r-lg: 32rpx;
  --r-md: 24rpx;
  --r-sm: 16rpx;
  --shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.07);
  --shadow-sm: 0 4rpx 14rpx rgba(15, 23, 42, 0.05);
  --grad: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #9333ea 100%);

  background: var(--canvas);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.65;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  letter-spacing: 0.2rpx;
}

/* ===== 頁面共用的漸層頁首 ===== */
.head {
  background: linear-gradient(140deg, #4f46e5 0%, #6d3ae8 52%, #9333ea 100%);
  padding: 48rpx 40rpx 100rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
}

.head-inner { position: relative; }

.head-eyebrow {
  display: inline-block;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 16rpx;
}

.head-title {
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.6rpx;
}

.head-sub {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* ===== 版面 ===== */
.wrap {
  padding: 0 28rpx 60rpx;
}

.card {
  position: relative;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.card--flat {
  box-shadow: var(--shadow-sm);
}

.card--tint {
  background: linear-gradient(180deg, #ffffff 0%, #f8f9ff 100%);
}

/* 疊在 hero 上的第一張卡 */
.card--overlap {
  margin-top: -72rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sec-title::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--grad);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted { color: var(--muted); font-size: 24rpx; }
.faint { color: var(--faint); font-size: 22rpx; }
.tiny  { font-size: 22rpx; }

/* ===== 表單 ===== */
.label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  margin: 28rpx 0 10rpx;
  letter-spacing: 0.4rpx;
}

.label:first-of-type { margin-top: 0; }

.input, .textarea, .field {
  width: 100%;
  box-sizing: border-box;
  background: #f6f8fc;
  border: 2rpx solid transparent;
  border-radius: var(--r-md);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  transition: border-color 0.18s ease, background 0.18s ease;
}

.input:focus, .textarea:focus {
  border-color: rgba(79, 70, 229, 0.45);
  background: #fff;
}

/* 單行輸入框：微信的 <input> 不會隨 padding 長高，必須顯式給高度，否則框很扁 */
.input {
  min-height: 104rpx;
  padding: 28rpx 28rpx;
  font-size: 30rpx;
}

.textarea { min-height: 200rpx; line-height: 1.6; }
.field { text-align: center; }

/* ===== 按鈕 ===== */
.btn {
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 14rpx 0;
  letter-spacing: 1rpx;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.btn::after { border: none; }
.btn-hover { transform: scale(0.975); opacity: 0.9; }

.btn-primary {
  background: var(--grad);
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(79, 70, 229, 0.28);
}

.btn-primary[disabled] {
  background: linear-gradient(135deg, #c7c9f5 0%, #d8c7f0 100%);
  color: #fff;
  box-shadow: none;
}

.btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid rgba(79, 70, 229, 0.28);
}

.btn-quiet {
  background: #f6f8fc;
  color: var(--muted);
}

.btn-danger {
  background: #fff;
  color: var(--danger);
  border: 2rpx solid rgba(239, 68, 68, 0.24);
}

.btn-sm { font-size: 26rpx; padding: 8rpx 0; }

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
}

.btn-group .btn { flex: 1; }

/* ===== 標籤 / 徽章 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  letter-spacing: 0.4rpx;
}

.tag-live { background: rgba(16, 185, 129, 0.12); color: #059669; }
.tag-end  { background: rgba(100, 116, 139, 0.12); color: var(--muted); }
.tag-info { background: rgba(79, 70, 229, 0.10); color: var(--primary); }
.tag-warn { background: rgba(245, 158, 11, 0.14); color: #b45309; }

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.dot-live { background: var(--success); box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.16); }
.dot-end { background: var(--faint); }

/* ===== 選項 / 芯片 ===== */
.chip {
  padding: 18rpx 26rpx;
  border-radius: var(--r-md);
  background: #f6f8fc;
  color: var(--muted);
  border: 2rpx solid transparent;
  font-size: 26rpx;
  transition: all 0.16s ease;
}

.chip-on {
  background: rgba(79, 70, 229, 0.07);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

.chip-row { display: flex; gap: 16rpx; }
.chip-row .chip { flex: 1; text-align: center; }

/* ===== 其他 ===== */
.divider { height: 2rpx; background: var(--line); margin: 26rpx 0; }

.empty {
  text-align: center;
  color: var(--faint);
  padding: 90rpx 40rpx;
  font-size: 26rpx;
}

.empty-glyph {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 18rpx;
  opacity: 0.55;
}

.err-box {
  color: var(--danger);
  font-size: 26rpx;
  background: rgba(239, 68, 68, 0.06);
  border-radius: var(--r-md);
  padding: 20rpx;
}

.notice {
  font-size: 24rpx;
  color: #b45309;
  background: rgba(245, 158, 11, 0.10);
  border-radius: var(--r-md);
  padding: 18rpx 22rpx;
  line-height: 1.55;
}

.notice-ok {
  color: #047857;
  background: rgba(16, 185, 129, 0.10);
}

.hint {
  font-size: 22rpx;
  color: var(--faint);
  margin-top: 10rpx;
  line-height: 1.5;
}

.submit-bar {
  padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}
