/* .head 共用樣式在 app.wxss */
.head-tag { background: rgba(255, 255, 255, 0.18); color: #fff; }
.head-tag .dot { background: #6ee7b7; }
.head-count { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; }

.head-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 20rpx;
}

.head-group {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.head-progress {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  margin-top: 22rpx;
  overflow: hidden;
}

.head-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transition: width 0.25s ease;
}

.head .card:first-of-type { margin-top: 0; }

.wrap > .card:first-child { margin-top: -56rpx; }

/* 提示條不要壓在紫色頁首上：深綠字在紫底上幾乎看不清 */
.wrap > .notice:first-child { margin-top: 24rpx; }

.notice { margin-bottom: 24rpx; }

/* 題目 */
.q-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.q-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
}

.q-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
  flex: 1;
}

.req { color: var(--danger); margin-left: 6rpx; }

.ph { color: #b6bfcc; }

.announce {
  white-space: pre-wrap;
  color: #334155;
  background: #fff;
  border-radius: var(--r-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  font-size: 27rpx;
}

/* 單選 */
.opts { display: flex; flex-direction: column; gap: 16rpx; }

.opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 22rpx 24rpx;
  color: #334155;
  background: #fbfcfe;
  transition: all 0.16s ease;
}

.opt-hover { opacity: 0.7; }

.opt-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 3rpx solid #cbd5e1;
  flex-shrink: 0;
}

.opt-on {
  border-color: var(--primary);
  background: rgba(79, 70, 229, 0.06);
  color: var(--primary);
  font-weight: 600;
}

.opt-on .opt-dot {
  border-color: var(--primary);
  background: radial-gradient(circle, var(--primary) 0%, var(--primary) 38%, #fff 44%);
}

.field-set {
  border-color: var(--primary);
  background: rgba(79, 70, 229, 0.06);
  color: var(--primary);
  font-weight: 600;
  text-align: left;
}

/* 已提交 */
.done-card { text-align: center; padding: 52rpx 32rpx 44rpx; }

.done-ico {
  width: 118rpx;
  height: 118rpx;
  line-height: 118rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  font-size: 56rpx;
  box-shadow: 0 14rpx 30rpx rgba(16, 185, 129, 0.32);
}

.done-ico--off { background: linear-gradient(135deg, #94a3b8, #64748b); }

.done-t { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }

.done-time { margin-bottom: 6rpx; }

.done-card .btn-group { margin-top: 26rpx; }

.answer-box {
  white-space: pre-wrap;
  color: #334155;
  background: #f6f8fc;
  border-radius: var(--r-md);
  padding: 22rpx;
}

/* 長表單：提交按鈕固定在底部，避免要滑到底才能交 */
.wrap { padding-bottom: 280rpx; }

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: linear-gradient(180deg, rgba(244, 246, 251, 0) 0%, rgba(244, 246, 251, 0.96) 26%, #f4f6fb 100%);
  padding: 24rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
}
