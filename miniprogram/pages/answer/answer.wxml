<view class="head">
  <view class="head-inner">
    <view class="row">
      <view class="tag tag-info head-tag">
        <text class="dot dot-live"></text>{{survey.myAnswers ? '已提交' : (survey.isClosed ? '已結束' : (survey.isExpired ? '已截止' : '進行中'))}}
      </view>
      <view class="head-count" wx:if="{{!survey.myAnswers && !survey.isClosed && !survey.isExpired}}">已答 {{answered}}/{{total}}</view>
    </view>
    <view class="head-title">{{survey.title}}</view>
    <view class="head-group" wx:if="{{survey.groupName}}">發問群組：{{survey.groupName}}</view>
    <view class="head-group" wx:if="{{openGId}}">
      本群：<open-data type="groupName" open-gid="{{openGId}}" default-text="（群名稱未識別）"></open-data>
    </view>
    <view class="head-progress" wx:if="{{survey && !survey.myAnswers && !survey.isClosed && !survey.isExpired}}">
      <view class="head-progress-bar" style="width: {{total ? answered / total * 100 : 0}}%"></view>
    </view>
  </view>
</view>

<view class="wrap">
  <view wx:if="{{loading}}" class="empty">
    <view class="empty-glyph">◍</view>載入中…
  </view>
  <view wx:elif="{{error}}" class="card">
    <view class="err-box">{{error}}</view>
  </view>

  <block wx:elif="{{survey}}">
    <view class="notice notice-ok" wx:if="{{groupNote}}">{{groupNote}}</view>
    <view class="notice" wx:elif="{{groupWarning}}">{{groupWarning}}</view>
    <view class="notice" wx:elif="{{survey.bindMode === 'group' && !openGId && !survey.myAnswers && !survey.isClosed && !survey.isExpired}}">
      請從微信群的問卷卡片進入作答，否則系統無法識別群組、提交會被擋下。（若這份問卷是用二維碼分發的，請建立者把作答範圍改成「開放作答」）
    </view>

    <view class="card card--tint" wx:if="{{survey.announcement}}">
      <view class="sec-title">公告內容</view>
      <view class="announce">{{survey.announcement}}</view>
    </view>

    <block wx:if="{{survey.myAnswers}}">
      <view class="card done-card">
        <view class="done-ico">🎉</view>
        <view class="done-t">已提交，感謝配合！</view>
        <view class="muted done-time" wx:if="{{submitTimeText}}">提交時間：{{submitTimeText}}</view>
        <view class="muted">一人限一份，如需修改請聯絡管理員。</view>
        <view class="btn-group">
          <button class="btn btn-ghost btn-sm" hover-class="btn-hover" open-type="share">提醒群友填寫</button>
        </view>
      </view>
      <view class="card" wx:for="{{survey.questions}}" wx:key="k" wx:for-item="q">
        <view class="q-head">
          <view class="q-no">{{index + 1}}</view>
          <view class="q-title">{{q.title}}</view>
        </view>
        <view class="answer-box">{{answers[q.k] || '（未填）'}}</view>
      </view>
    </block>

    <block wx:elif="{{survey.isClosed || survey.isExpired}}">
      <view class="card done-card">
        <view class="done-ico done-ico--off">—</view>
        <view class="done-t">{{survey.isExpired ? '此問卷已截止' : '此問卷已結束'}}</view>
        <view class="muted">如需補答請聯絡管理員。</view>
      </view>
    </block>

    <block wx:else>
      <view class="card" wx:for="{{survey.questions}}" wx:key="k" wx:for-item="q" id="q-{{q.k}}">
        <view class="q-head">
          <view class="q-no">{{index + 1}}</view>
          <view class="q-title">{{q.title}}<text class="req" wx:if="{{q.required}}">*</text></view>
        </view>

        <input
          wx:if="{{q.type === 'text' && q.k === 'name'}}"
          class="input"
          value="{{answers[q.k]}}"
          data-k="{{q.k}}"
          bindinput="onText"
          placeholder="填寫你的姓名／稱呼"
          placeholder-class="ph"
          maxlength="50"
        />

        <textarea
          wx:elif="{{q.type === 'text'}}"
          class="textarea"
          value="{{answers[q.k]}}"
          data-k="{{q.k}}"
          bindinput="onText"
          placeholder="寫下你的理解或想法"
          placeholder-class="ph"
          maxlength="2000"
        />

        <picker wx:elif="{{q.type === 'date'}}" mode="date" value="{{answers[q.k]}}" data-k="{{q.k}}" bindchange="onDate">
          <view class="field {{answers[q.k] ? 'field-set' : ''}}">{{answers[q.k] || '點此選擇日期'}}</view>
        </picker>

        <view wx:else class="opts">
          <view
            class="opt {{answers[q.k] === opt ? 'opt-on' : ''}}"
            wx:for="{{q.options}}"
            wx:key="*this"
            wx:for-item="opt"
            hover-class="opt-hover"
            data-k="{{q.k}}"
            data-opt="{{opt}}"
            bindtap="onChoice"
          >
            <view class="opt-dot"></view>{{opt}}
          </view>
        </view>
      </view>

      <view class="submit-bar">
        <button class="btn btn-primary" hover-class="btn-hover" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交問卷</button>
        <view class="hint" style="text-align:center">提交後無法修改，管理員可見回收狀況</view>
      </view>
    </block>
  </block>
</view>
