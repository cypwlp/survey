.card--overlap { margin-top: -64rpx; }

.head .tag { background: rgba(255, 255, 255, 0.18); color: #fff; }
.head .dot-live { background: #6ee7b7; }
.head .dot-end { background: rgba(255, 255, 255, 0.6); }

.item-hover { transform: scale(0.985); opacity: 0.95; }

.grid2 {
  display: flex;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.tile {
  flex: 1;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 28rpx 26rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.tile--off { opacity: 0.45; }

.g-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--line);
}

.g-line:first-of-type { border-top: none; }

.g-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: rgba(79, 70, 229, 0.09);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
  flex-shrink: 0;
}

.g-body { flex: 1; }

.g-id {
  font-size: 24rpx;
  color: #334155;
  word-break: break-all;
  margin-bottom: 4rpx;
}

.tile-t {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.announce {
  white-space: pre-wrap;
  color: #334155;
  background: #fff;
  border-radius: var(--r-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  font-size: 27rpx;
}

.q-line {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
}

.q-line:first-of-type { border-top: none; padding-top: 4rpx; }

.q-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
}

.q-body { flex: 1; }

.q-t { font-size: 28rpx; font-weight: 600; line-height: 44rpx; }

.q-tags { display: flex; gap: 10rpx; margin-top: 8rpx; flex-wrap: wrap; }

.mini {
  font-size: 21rpx;
  color: var(--muted);
  background: #f1f4f9;
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
}

.mini-req { color: var(--danger); background: rgba(239, 68, 68, 0.08); }

.mini-key { color: var(--faint); background: transparent; border: 2rpx solid var(--line); }

.edit-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.mv-col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.mv {
  width: 56rpx;
  height: 46rpx;
  border-radius: 12rpx;
  background: #f1f4f9;
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
  line-height: 46rpx;
}

.mv-off { opacity: 0.25; }

.opt-hover { opacity: 0.66; }

/* ===== 編輯題目模式 ===== */
.ph { color: #b6bfcc; }

.q-card {
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-top: 22rpx;
  background: #fcfdff;
}

.q-tools {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.type-pill {
  font-size: 24rpx;
  color: var(--muted);
  background: #f1f4f9;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.del {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 4rpx;
}

.q-title {
  min-height: 120rpx;
  margin-top: 20rpx;
  background: #fff;
}

.opt-editor { margin-top: 16rpx; }

.q-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.req-toggle {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.add-btn {
  display: inline-flex;
  margin-top: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}
