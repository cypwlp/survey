.card--overlap { margin-top: -64rpx; }

/* 分享與管理區 */

.btn-share { margin-top: 24rpx; }

.quick-row {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.quick {
  flex: 1;
  background: #f7f9fd;
  border-radius: var(--r-md);
  padding: 20rpx 8rpx 18rpx;
  text-align: center;
  transition: opacity 0.15s ease;
}

.quick-hover { opacity: 0.62; }

.quick-ico {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0 auto 10rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.quick-ico--a { background: linear-gradient(135deg, #0ea5e9, #6366f1); }
.quick-ico--b { background: linear-gradient(135deg, #4f46e5, #7c3aed); }
.quick-ico--c { background: linear-gradient(135deg, #64748b, #94a3b8); }

.quick-t {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.menu { margin-top: 6rpx; }

.menu-picker { display: block; }

.menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--line);
}

.menu-row:first-child {
  border-top: none;
  padding-top: 8rpx;
}

.menu-hover { opacity: 0.6; }

.menu-main { flex: 1; }

.menu-t {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.menu-d {
  font-size: 23rpx;
  color: var(--faint);
  margin-top: 4rpx;
}

.menu-side {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.menu-arrow {
  font-size: 42rpx;
  color: #cbd5e1;
  line-height: 1;
}

.menu-row--danger .menu-t { color: var(--danger); }
.menu-row--danger .menu-d { color: #f0a3a3; }

.link-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  padding: 4rpx 0;
}

.announce--clamp {
  max-height: 240rpx;
  overflow: hidden;
}

.head .tag { background: rgba(255, 255, 255, 0.18); color: #fff; }
.head .dot-live { background: #6ee7b7; }
.head .dot-end { background: rgba(255, 255, 255, 0.6); }

.item-hover { transform: scale(0.985); opacity: 0.95; }

.grid2 {
  display: flex;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.tile {
  flex: 1;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 28rpx 26rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.tile--off { opacity: 0.45; }

.g-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--line);
}

.g-line:first-of-type { border-top: none; }

.g-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: rgba(79, 70, 229, 0.09);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
  flex-shrink: 0;
}

.g-body { flex: 1; }

.g-id {
  font-size: 24rpx;
  color: #334155;
  word-break: break-all;
  margin-bottom: 4rpx;
}

.tile-t {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.announce {
  white-space: pre-wrap;
  color: #334155;
  background: #fff;
  border-radius: var(--r-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  font-size: 27rpx;
}

.q-line {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
}

.q-line:first-of-type { border-top: none; padding-top: 4rpx; }

.q-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
}

.q-body { flex: 1; }

.q-t { font-size: 28rpx; font-weight: 600; line-height: 44rpx; }

.q-tags { display: flex; gap: 10rpx; margin-top: 8rpx; flex-wrap: wrap; }

.mini {
  font-size: 21rpx;
  color: var(--muted);
  background: #f1f4f9;
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
}

.mini-req { color: var(--danger); background: rgba(239, 68, 68, 0.08); }

.mini-key { color: var(--faint); background: transparent; border: 2rpx solid var(--line); }

.edit-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.mv-col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.mv {
  width: 56rpx;
  height: 46rpx;
  border-radius: 12rpx;
  background: #f1f4f9;
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
  line-height: 46rpx;
}

.mv-off { opacity: 0.25; }

.opt-hover { opacity: 0.66; }

/* ===== 編輯題目模式 ===== */
.ph { color: #b6bfcc; }

.q-card {
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-top: 22rpx;
  background: #fcfdff;
}

.q-tools {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.type-pill {
  font-size: 24rpx;
  color: var(--muted);
  background: #f1f4f9;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.del {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 4rpx;
}

.q-title {
  min-height: 120rpx;
  margin-top: 20rpx;
  background: #fff;
}

.opt-editor { margin-top: 16rpx; }

.q-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.req-toggle {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.add-btn {
  display: inline-flex;
  margin-top: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

/* 小程序碼彈窗：未認證帳號靠這張圖分發問卷 */
.qr-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.qr-panel {
  width: 590rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 40rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  box-shadow: var(--shadow);
}

.qr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.qr-img {
  width: 430rpx;
  border-radius: var(--r-sm);
  background: #fff;
}

.qr-loading,
.qr-err {
  min-height: 430rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--muted);
  font-size: 27rpx;
  padding: 0 20rpx;
}

.qr-err { color: var(--danger); }

.qr-tip {
  font-size: 26rpx;
  color: var(--ink);
  text-align: center;
}

.qr-tip-faint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.qr-save {
  width: 100%;
  margin-top: 4rpx;
}
