<view class="head">
  <view class="head-inner">
    <view class="row">
      <view class="head-eyebrow">問卷詳情</view>
      <view class="tag {{survey.isClosed ? 'tag-end' : 'tag-live'}}" wx:if="{{survey}}">
        <text class="dot {{survey.isClosed ? 'dot-end' : 'dot-live'}}"></text>{{survey.isClosed ? '已結束' : '進行中'}}
      </view>
    </view>
    <view class="head-title">{{survey.title}}</view>
    <view class="head-sub" wx:if="{{survey}}">{{survey.groupName || '未填群名'}}｜{{survey.bindMode === 'group' ? (survey.hasGroupBound ? '已有 ' + survey.groups.length + ' 個群加入' : '還沒有人從群裡進來') : '開放作答'}}</view>
  </view>
</view>

<view class="wrap">
  <view wx:if="{{loading}}" class="card card--overlap empty"><view class="empty-glyph">◍</view>載入中…</view>
  <view wx:elif="{{error}}" class="card card--overlap"><view class="err-box">{{error}}</view></view>

  <block wx:elif="{{survey}}">
    <view class="card card--overlap" wx:if="{{survey.isCreator}}">
      <view class="sec-title">分享到微信群</view>
      <button class="btn btn-primary" hover-class="btn-hover" open-type="share">送出問卷卡片</button>
      <view class="hint">分享前請確認已開啟「群分享攜帶 shareTicket」；成員必須從群裡的卡片進入，系統才能綁定該群。</view>
      <view class="btn-group">
        <button class="btn btn-ghost btn-sm" hover-class="btn-hover" bindtap="goStats">查看統計</button>
        <button class="btn btn-quiet btn-sm" hover-class="btn-hover" bindtap="copyPath">複製進入路徑</button>
        <button class="btn btn-quiet btn-sm" hover-class="btn-hover" bindtap="openQrcode">小程序碼</button>
      </view>
      <view class="hint">未被搜尋／被分享的帳號（未認證）用「小程序碼」分發：長按圖片保存或轉發，朋友掃碼即進入（僅「開放作答」模式；「綁定群組」必須從群卡片進入）。</view>
    </view>

    <view class="grid2" wx:if="{{survey.isCreator}}">
      <view class="tile" hover-class="item-hover" bindtap="toggleClose">
        <view class="tile-t">{{survey.isClosed ? '重新開放' : '結束問卷'}}</view>
        <view class="faint">{{survey.isClosed ? '讓成員能繼續提交' : '停止接收新答案'}}</view>
      </view>
      <view class="tile {{survey.bindMode === 'group' && survey.hasGroupBound ? '' : 'tile--off'}}"
            hover-class="item-hover" bindtap="unbind"
            wx:if="{{survey.bindMode === 'group' && survey.hasGroupBound}}">
        <view class="tile-t">解除全部群綁定</view>
        <view class="faint">清掉已加入的群，重新累計</view>
      </view>
    </view>

    <view class="grid2" wx:if="{{survey.isCreator}}">
      <view class="tile" hover-class="item-hover" bindtap="toggleBindMode">
        <view class="tile-t">{{survey.bindMode === 'group' ? '改為「開放作答」' : '改為「綁定群組」'}}</view>
        <view class="faint">{{survey.bindMode === 'group' ? '掃碼／轉發都能提交，適合二維碼分發' : '恢復成必須從群卡片進入'}}</view>
      </view>
    </view>

    <view class="card card--flat" wx:if="{{survey.bindMode === 'group' && survey.groups.length}}">
      <view class="sec-title">已加入的群（{{survey.groups.length}}）</view>
      <view class="g-line" wx:for="{{survey.groups}}" wx:key="openGId">
        <view class="g-no">{{index + 1}}</view>
        <view class="g-body">
          <view class="g-id">{{item.openGId}}</view>
          <view class="faint">首次進入：{{item.firstSeenAt}}</view>
        </view>
      </view>
      <view class="hint" wx:if="{{survey.groups.length === 1}}">把同一張卡片再轉發到別的群，那個群也會自動加入（多群模型）。</view>
    </view>

    <view class="card card--tint" wx:if="{{survey.announcement}}">
      <view class="sec-title">公告內容</view>
      <view class="announce">{{survey.announcement}}</view>
    </view>

    <view class="card">
      <view class="row">
        <view class="sec-title" style="margin-bottom:0">題目（{{survey.questions.length}}）</view>
      <view class="edit-btn" wx:if="{{survey.isCreator && !editMode}}" hover-class="opt-hover" bindtap="toggleEdit">編輯題目</view>
      </view>
    <view class="hint" wx:if="{{editMode}}">可改題干、類型、選項與必填，也能加題／刪題／調順序。答案以題目編號對應：已提交的答卷不受影響，刪掉的題目不再統計。</view>

    <block wx:if="{{!editMode}}">
        <view class="q-line" wx:for="{{survey.questions}}" wx:key="k">
          <view class="q-no">{{index + 1}}</view>
          <view class="q-body">
            <view class="q-t">{{item.title}}</view>
            <view class="q-tags">
              <text class="mini">{{item.type === 'choice' ? '單選' : (item.type === 'date' ? '日期' : '填充')}}</text>
              <text class="mini {{item.required ? 'mini-req' : ''}}">{{item.required ? '必填' : '選填'}}</text>
              <text class="mini mini-key">{{item.k}}</text>
            </view>
            <view class="faint" wx:if="{{item.type === 'choice'}}">{{item.options}}</view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="q-card" wx:for="{{draft}}" wx:key="uid">
          <view class="row">
            <view class="q-no">{{index + 1}}</view>
            <view class="q-tools">
              <view class="mv {{index === 0 ? 'mv-off' : ''}}" hover-class="opt-hover" data-index="{{index}}" data-dir="-1" bindtap="moveQuestion">▲</view>
              <view class="mv {{index === draft.length - 1 ? 'mv-off' : ''}}" hover-class="opt-hover" data-index="{{index}}" data-dir="1" bindtap="moveQuestion">▼</view>
              <picker range="{{typeLabels}}" value="{{item.typeIndex}}" data-index="{{index}}" bindchange="onQuestionType">
                <view class="type-pill">{{typeLabels[item.typeIndex]}} ▾</view>
              </picker>
              <view class="del" hover-class="opt-hover" data-index="{{index}}" bindtap="removeQuestion">刪除</view>
            </view>
          </view>

          <textarea class="textarea q-title" value="{{item.title}}" data-index="{{index}}" bindinput="onQuestionTitle" placeholder="題目內容" placeholder-class="ph" maxlength="300" />

          <view wx:if="{{item.type === 'choice'}}" class="opt-editor">
            <input class="input" value="{{item.optionsText}}" data-index="{{index}}" bindinput="onQuestionOptions" placeholder="選項用逗號分隔：同意，有疑問，不同意" placeholder-class="ph" />
          </view>

          <view class="q-foot">
            <view class="req-toggle">
              <switch checked="{{item.required}}" data-index="{{index}}" bindchange="onQuestionRequired" color="#4F46E5" style="transform:scale(0.72)" />
              <text class="muted">必填</text>
            </view>
            <view class="faint" wx:if="{{item.k}}">key：{{item.k}}</view>
          </view>
        </view>

        <view class="add-btn" hover-class="opt-hover" bindtap="addQuestion">＋ 加一題</view>

        <view class="btn-group">
          <button class="btn btn-primary btn-sm" hover-class="btn-hover" bindtap="saveQuestions" loading="{{saving}}" disabled="{{saving}}">保存修改</button>
          <button class="btn btn-quiet btn-sm" hover-class="btn-hover" bindtap="cancelEdit">取消</button>
        </view>
      </block>
    </view>

    <view class="card" wx:if="{{survey.isCreator}}">
      <view class="sec-title">刪除問卷</view>
      <view class="hint">把這份問卷連同它的全部答卷、開啟記錄、群綁定一起刪掉，不可恢復。</view>
      <button class="btn btn-danger btn-sm" hover-class="btn-hover" bindtap="deleteSurvey" loading="{{deleting}}" disabled="{{deleting}}">刪除這份問卷</button>
    </view>
  </block>
</view>

<view class="qr-mask" wx:if="{{qrVisible}}" bindtap="closeQrcode">
  <view class="qr-panel" catchtap="noop">
    <view class="qr-title">掃碼進入問卷</view>
    <view class="qr-loading" wx:if="{{qrLoading}}">正在生成小程序碼…</view>
    <view class="qr-err" wx:elif="{{qrError}}">{{qrError}}</view>
    <block wx:else>
      <image class="qr-img" src="{{qrImage}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <view class="qr-tip">長按圖片 → 保存到手機 或 轉發給朋友</view>
      <view class="qr-tip qr-tip-faint">朋友掃一掃／在聊天裡長按識別，就能直接進入答題頁</view>
    </block>
    <button class="btn btn-quiet btn-sm" hover-class="btn-hover" bindtap="closeQrcode">關閉</button>
  </view>
</view>
