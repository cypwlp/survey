.card--overlap { margin-top: -64rpx; }

/* 搜尋與篩選 */
.search-card { padding: 24rpx 26rpx; }

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f6f8fc;
  border-radius: 999rpx;
  padding: 0 24rpx;
  min-height: 84rpx;
}

.search-ico {
  color: var(--faint);
  font-size: 32rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 27rpx;
}

.search-clear {
  color: var(--faint);
  font-size: 26rpx;
  padding: 8rpx;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.filter-chip {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  background: #f6f8fc;
  border-radius: 999rpx;
  padding: 12rpx 0;
  border: 2rpx solid transparent;
}

.filter-chip--on {
  color: var(--primary);
  background: rgba(79, 70, 229, 0.07);
  border-color: rgba(79, 70, 229, 0.28);
  font-weight: 600;
}

.ph { color: #b6bfcc; }
.opt-hover { opacity: 0.6; }

.item {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 30rpx 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 22rpx;
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.item-hover { transform: scale(0.988); opacity: 0.94; }

.i-title {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.i-meta {
  font-size: 23rpx;
  color: var(--faint);
  margin-top: 8rpx;
}

.i-deadline {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 6rpx;
}

.i-stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  background: #f7f9fd;
  border-radius: var(--r-md);
  padding: 18rpx 0;
}

.i-stat { flex: 1; text-align: center; }

.i-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.i-num--sm { font-size: 26rpx; color: #334155; }

.i-sep { width: 2rpx; height: 44rpx; background: var(--line); }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(64rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  font-size: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 34rpx rgba(79, 70, 229, 0.36);
  transition: transform 0.14s ease;
}

.fab-hover { transform: scale(0.92); }

.purge-zone {
  padding: 6rpx 6rpx 150rpx;
  text-align: center;
}

.purge-zone .btn { padding-left: 0; padding-right: 0; }

.load-more {
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: #fff;
  border-radius: 999rpx;
  padding: 18rpx 0;
  margin: 6rpx 0 18rpx;
  box-shadow: var(--shadow-sm);
}
