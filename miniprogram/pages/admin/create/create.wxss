.card--overlap { margin-top: -64rpx; }

.ph { color: #b6bfcc; }

/* 群名多標籤 */
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }

.g-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.07);
  border: 2rpx solid rgba(79, 70, 229, 0.22);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.g-del { font-size: 22rpx; color: var(--faint); padding: 0 2rpx; }

.g-tag--pick {
  color: var(--muted);
  background: #f6f8fc;
  border-color: var(--line);
  font-weight: 400;
}

.add-tag {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border-radius: 14rpx;
  padding: 18rpx 34rpx;
  flex-shrink: 0;
}

.row .input { width: auto; }

.saved {
  background: #fafbfd;
  border-radius: var(--r-md);
  padding: 20rpx;
  margin-top: 8rpx;
}

.saved .g-tag { display: inline-flex; margin: 0 12rpx 12rpx 0; }

.add-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.q-card {
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-top: 22rpx;
  background: #fcfdff;
}

.q-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
}

.q-tools {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.type-pill {
  font-size: 24rpx;
  color: var(--muted);
  background: #f1f4f9;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.del {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 4rpx;
}

.q-title {
  min-height: 120rpx;
  margin-top: 20rpx;
  background: #fff;
}

.opt-editor { margin-top: 16rpx; }

.q-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.req-toggle {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.opt-hover { opacity: 0.66; }
