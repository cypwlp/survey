.card--overlap { margin-top: -64rpx; }

.ph { color: #b6bfcc; }

/* 群名多標籤 */
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }

.g-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.07);
  border: 2rpx solid rgba(79, 70, 229, 0.22);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.g-del { font-size: 22rpx; color: var(--faint); padding: 0 2rpx; }

.g-tag--on {
  color: #fff;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border-color: transparent;
}

.add-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 104rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border-radius: 14rpx;
  padding: 0 34rpx;
  flex-shrink: 0;
}

.inline-link {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary);
  margin-top: 12rpx;
}

.field-set {
  border-color: var(--primary);
  background: rgba(79, 70, 229, 0.06);
  color: var(--primary);
  font-weight: 600;
  text-align: left;
}

.row .input { width: auto; }

/* 標題用可長高的 textarea，比單行 input 好按、也看得完整 */
.title-box { min-height: 104rpx; line-height: 1.5; }

.saved {
  background: #fafbfd;
  border-radius: var(--r-md);
  padding: 20rpx;
  margin-top: 8rpx;
}

.saved .g-tag { display: inline-flex; margin: 0 12rpx 12rpx 0; }

.add-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(79, 70, 229, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.q-card {
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-top: 22rpx;
  background: #fcfdff;
}

.q-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
}

.q-tools {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.type-pill {
  font-size: 24rpx;
  color: var(--muted);
  background: #f1f4f9;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.del {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 4rpx;
}

.mv {
  width: 56rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #f1f4f9;
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
  line-height: 44rpx;
}

.mv-off { opacity: 0.25; }

.q-title {
  min-height: 120rpx;
  margin-top: 20rpx;
  background: #fff;
}

.opt-editor { margin-top: 16rpx; }

.q-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.req-toggle {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.opt-hover { opacity: 0.66; }

/* 建立按鈕固定在底部，長表單不用滑到底 */
.wrap { padding-bottom: 280rpx; }

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: linear-gradient(180deg, rgba(244, 246, 251, 0) 0%, rgba(244, 246, 251, 0.96) 26%, #f4f6fb 100%);
  padding: 24rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
}
