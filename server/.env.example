# 複製本檔為 .env 後填寫。.env 不要進版控。

# ── 伺服器 ─────────────────────────────
PORT=3000

# 資料庫驅動：mssql = 連 SQL Server（正式）；memory = 記憶體示範（重啟即清空，不需要 DB）
DB_DRIVER=memory

# ── SQL Server（DB_DRIVER=mssql 時必填）──
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=SurveySystem

# ── 微信小程序 ─────────────────────────
# 正式上線必填（mp.weixin.qq.com → 開發管理 → 開發設定）。
# 留空 = dev 模式：login 可用 dev:任意字串 換假 openid，全鏈路可離線演練。
WX_APPID=
WX_SECRET=

# ── 其他 ──────────────────────────────
# token 簽名密鑰：必改成長隨機字串（例如 64 個 hex）
TOKEN_SECRET=change-me-please-a-long-random-string
