# 生產環境設定（放 10.241.50.213 的 server/.env.production，不要進版控）
# docker compose 會自動讀這個檔並注入容器環境變數

PORT=3000

# ── 資料庫（指向 ERP 那台伺服器上的 OSurveyDB）──
DB_DRIVER=mssql
DB_SERVER=10.241.48.1
DB_PORT=1433
DB_USER=osurvey_app
DB_PASSWORD=在這裡填專用帳號的密碼
DB_NAME=OSurveyDB

# ── 微信小程序 ──
WX_APPID=wx07d9f0e6c8fba227
WX_SECRET=在這裡填 AppSecret

# ── token 簽名密鑰（換成一串新的隨機 64 字元，不要沿用開發機那組）──
TOKEN_SECRET=change-me-to-a-new-random-64-hex
